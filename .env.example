# ── Required (server) ─────────────────────────────────────────
OPENROUTER_API_KEY=              # https://openrouter.ai/keys
SUPABASE_URL=                    # https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # server only, never expose
SESSION_SECRET=                  # long random string (openssl rand -hex 32)

# ── Required (public) ─────────────────────────────────────────
NEXT_PUBLIC_TREASURY=0x...       # wallet that receives top-ups
NEXT_PUBLIC_SITE_URL=https://www.synaps.chat
NEXT_PUBLIC_PRIVY_APP_ID=        # https://dashboard.privy.io

# ── Pricing & limits (optional, defaults shown) ───────────────
MARKUP=0.2                       # 20% on top of provider cost
MIN_BALANCE_USD=0.02             # minimum balance to call paid models
FREE_DAILY_LIMIT=20              # free messages per browser and per IP per day
FREE_GLOBAL_DAILY_LIMIT=800      # all free traffic together per day
WEB_SEARCH_FEE_USD=0.02          # flat fee per message with web search on

# ── Referrals (optional) ──────────────────────────────────────
REF_REFERRER_PCT=0.1             # inviter gets 10% of the friend's first top-up
REF_REFEREE_PCT=0.05             # friend gets +5%
REF_CAP_USD=20
REF_MIN_USD=2

# ── $SYNAPS token (optional) ──────────────────────────────────
SYNAPS_BONUS=0.1                 # +10% credit when paying with $SYNAPS
SYNAPS_BONUS_CAP_USD=500
SYNAPS_TOKEN_ADDRESS=            # override auto-detection
SYNAPS_POOL_ADDRESS=             # override the pool used for pricing

# ── Admin & RPC (optional) ────────────────────────────────────
ADMIN_ADDRESSES=                 # comma-separated; defaults to the treasury
LOW_CREDIT_USD=5                 # admin alert when OpenRouter credit drops below this
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BASE_RPC_URL=https://mainnet.base.org
